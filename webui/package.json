{
  "name": "knect-webui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "knect embedded topology, policy, and tap console",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:e2e": "playwright test",
    "embed": "npm run build && node scripts/copy-dist.mjs",
    "preview:mock": "node e2e/mock-server.mjs",
    "verify": "npm run check && npm test -- --run && npm run build"
  },
  "dependencies": {
    "@xyflow/svelte": "1.7.0",
    "dagre": "0.8.5",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/dagre": "0.7.54",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
